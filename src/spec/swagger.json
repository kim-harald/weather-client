								"schema": {
									"type": "number",
									"format": "double"
								}
							}
						}
					}
				},
				"description": "Recomputes all summary values for a given summary type, location, and date range.\r\nThis recalculates the aggregated values from source readings.",
				"tags": [
					"summary"
				],
				"security": [],
				"parameters": [
					{
						"description": "The type of summary ('daily' or 'hourly')",
						"in": "path",
						"name": "summaryType",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Location to recompute summaries for",
						"in": "path",
						"name": "location",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Start timestamp",
						"in": "path",
						"name": "start",
						"required": true,
						"schema": {
							"format": "double",
							"type": "number"
						}
					},
					{
						"description": "End timestamp",
						"in": "path",
						"name": "end",
						"required": true,
						"schema": {
							"format": "double",
							"type": "number"
						}
					}
				]
			}
		},
